---
// 공식 구매처 — 데이터는 src/data/stores.ts 한 곳에서 관리합니다.
// 제품 페이지에서는 같은 목록을 팝업으로도 띄웁니다. data-buy-popup 이 붙은 링크('구매처 보기' 버튼)만 팝업을 열고,
// 다른 '구매처' 링크(페이지 안 목차, 다른 페이지에서 들어오는 링크)는 지금처럼 페이지 아래 구매처 칸으로 이동합니다.
// (휴대폰에서는 화면 아래에서 올라오는 창으로 보이고, 뒤로 가기·바깥 누르기·X 버튼으로 닫힙니다.)
import StoreList from './StoreList.astro';
import type { ProductKey } from '../data/stores';
// product: 'sunscreen'(선크림) / 'cleansing'(클렌징 밀크) / 'all'(전체)
// compact: 제목을 작게 쓸 때 true
interface Props { product?: ProductKey | 'all'; title?: string; compact?: boolean }
const { product = 'all', title = 'Official retailers', compact = false } = Astro.props;
---
<section id="buy" aria-labelledby="buy-title" style={`border-top: 1px solid #D5E0E8; padding: ${compact ? 'clamp(40px, 5vw, 64px)' : 'clamp(48px, 6vw, 88px)'} 0`}>
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 12px">
{!compact && <p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">WHERE TO BUY</p>}
<h2 id="buy-title" style={`margin: 0; font-size: ${compact ? 'clamp(20px, 2vw, 24px)' : 'clamp(24px, 2.6vw, 34px)'}; line-height: 1.3; color: #12324F`}>{title}</h2>
<p style="margin: 0; color: #3C4752">Also available at partner pharmacies across Korea.</p>
</div>
<StoreList product={product} />
</div>
</section>

{product !== 'all' && (
<dialog id="buy-dialog" class="buy-dialog" aria-labelledby="buy-dialog-title">
<div class="bd-inner">
<div class="bd-head">
<h2 id="buy-dialog-title" class="bd-title">{title}</h2>
<button type="button" class="bd-close" data-close aria-label="Close"><svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12"></path><path d="M18 6L6 18"></path></svg></button>
</div>
<p class="bd-note">Also available at partner pharmacies across Korea.</p>
<StoreList product={product} />
</div>
</dialog>
)}

<style>
  .buy-dialog { border: 0; padding: 0; width: min(600px, calc(100vw - 32px)); max-width: none; max-height: min(84vh, 760px); background: #F5F8FA; color: #1B2630; box-shadow: 0 24px 64px rgba(10, 22, 34, 0.28); overscroll-behavior: contain; }
  .buy-dialog::backdrop { background: rgba(10, 22, 34, 0.55); }
  .buy-dialog[open] { animation: bd-fade 0.18s ease-out; }
  .bd-inner { padding: clamp(22px, 3vw, 32px); display: flex; flex-direction: column; gap: 18px; }
  .bd-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; }
  .bd-title { margin: 0; font-size: clamp(20px, 2.2vw, 24px); line-height: 1.35; color: #12324F; }
  .bd-close { flex: none; width: 44px; height: 44px; margin: -10px -10px 0 0; display: inline-flex; align-items: center; justify-content: center; border: 0; background: transparent; color: #12324F; cursor: pointer; }
  .bd-close:focus-visible { outline: 2px solid #1170AE; outline-offset: 2px; }
  .bd-note { margin: -6px 0 0; color: #3C4752; }
  :global(html.buy-open) { overflow: hidden; }
  @keyframes bd-fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  /* 휴대폰: 화면 아래에서 올라오는 창 */
  @media (max-width: 760px) {
    .buy-dialog { width: 100%; max-height: 88vh; margin: auto 0 0; box-shadow: 0 -12px 40px rgba(10, 22, 34, 0.25); }
    .buy-dialog[open] { animation: bd-up 0.22s ease-out; }
    .bd-inner { padding: 20px 20px calc(24px + env(safe-area-inset-bottom)); }
  }
  @keyframes bd-up { from { transform: translateY(100%); } to { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .buy-dialog[open] { animation: none; } }
</style>

<script>
  const dlg = document.getElementById('buy-dialog') as HTMLDialogElement | null;
  if (dlg && typeof dlg.showModal === 'function') {
    const root = document.documentElement;
    const open = () => {
      if (dlg.open) return;
      dlg.showModal();
      root.classList.add('buy-open');
      history.pushState({ buyDialog: true }, '');
    };
    dlg.addEventListener('close', () => {
      root.classList.remove('buy-open');
      if (history.state && history.state.buyDialog) history.back();
    });
    window.addEventListener('popstate', () => { if (dlg.open) dlg.close(); });
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dlg.close()));
    document.querySelectorAll('a[data-buy-popup]').forEach((a) => a.addEventListener('click', (e) => { e.preventDefault(); open(); }));
  }
</script>
