---
// 시술별 가이드 페이지의 '받으신 시술을 골라 보세요' — 시술 7개 상세
import type { Proc } from '../data/guides';
// 이 부품을 쓰는 페이지가 시술 목록(procs)을 넘겨줍니다. 예: <ProcedurePicker procs={g.procs} />
interface Props { procs: Proc[] }
const { procs } = Astro.props;
const chip = 'min-height: 44px; padding: 8px 18px; border-radius: 999px; font-family: inherit; font-size: 15px; cursor: pointer';
const listStyle = 'margin: 0; padding-left: 18px; display: flex; flex-direction: column; gap: 6px; color: #3C4752';
---
<div data-picker data-param="p" style="display: flex; flex-direction: column; gap: 24px">
{/* 시술이 하나뿐이면 칩 줄을 숨깁니다 */}
<div role="group" aria-label="Choose a procedure" hidden={procs.length < 2} style="display: flex; flex-wrap: wrap; gap: 10px">
{procs.map((p, i) => (
  <button type="button" data-pick={i} data-base={chip} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`proc-${i}`}
    style={`${chip}; ${i === 0 ? 'border: 1px solid #12324F; background: #12324F; color: #FFFFFF; font-weight: 700' : 'border: 1px solid #B9C9D6; background: #FFFFFF; color: #12324F; font-weight: 500'}`}>{p.name}</button>
))}
</div>
{procs.map((p, i) => (
<article id={`proc-${i}`} data-panel={i} style="border: 1px solid #D5E0E8; border-top: 3px solid #12324F; padding: clamp(20px, 3vw, 40px); display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 6px; max-width: 900px">
<h3 style="margin: 0; font-size: clamp(22px, 2.2vw, 28px); line-height: 1.3; color: #12324F">{p.name}</h3>
<p style="margin: 0; font-size: 14px; color: #56626D">{p.alias}</p>
<p style="margin: 6px 0 0; color: #3C4752"><strong style="color: #12324F">Skin after the procedure</strong> · {p.skin}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px">
<div style="flex: 1 1 300px; min-width: 0; border: 1px solid #D5E0E8; padding: 22px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #1170AE">
<p style="margin: 0; font-size: 14px; font-weight: 700; color: #1170AE">Backhap Recovery Sunscreen</p>
<p style="margin: 0; font-size: clamp(19px, 1.8vw, 22px); font-weight: 700; line-height: 1.35">{p.sunWhen}</p>
<ul style={listStyle}>{p.sunHow.map((t) => <li>{t}</li>)}</ul>
</div>
<div style="flex: 1 1 300px; min-width: 0; border: 1px solid #D5E0E8; padding: 22px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #2F5233">
<p style="margin: 0; font-size: 14px; font-weight: 700; color: #2F5233">Matcha Depuffing Cleansing Milk</p>
<p style="margin: 0; font-size: clamp(19px, 1.8vw, 22px); font-weight: 700; line-height: 1.35">{p.cleanWhen}</p>
<ul style={listStyle}>{p.cleanHow.map((t) => <li>{t}</li>)}</ul>
</div>
<div style="flex: 1 1 300px; min-width: 0; border: 1px solid #D5E0E8; padding: 22px; display: flex; flex-direction: column; gap: 10px; border-top: 3px solid #56626D">
<p style="margin: 0; font-size: 14px; font-weight: 700; color: #56626D">Also keep in mind</p>
<ul style={listStyle}>{p.avoid.map((t) => <li>{t}</li>)}</ul>
</div>
</div>
<div style="border: 1px solid #D5E0E8; border-left: 4px solid #1170AE; padding: 18px 22px; display: flex; flex-direction: column; gap: 8px">
<p style="margin: 0; font-weight: 700; color: #12324F">What to know about NEUVELIF products</p>
<ul style={listStyle}>{p.product.map((t) => <li>{t}</li>)}</ul>
</div>
<p style="margin: 0; font-size: 14px; color: #56626D">If your clinic's instructions differ, follow your clinic. Do not apply to wounds or scabs.</p>
</article>
))}
</div>

<script>
  import { initPickers } from '../../../scripts/picker';
  initPickers();
</script>
