---
// 제품 목록 (주소: /products/)
import Base from '../../../i18n/ja/layouts/Base.astro';
import ProductCards from '../../../i18n/ja/components/ProductCards.astro';
import { breadcrumbs, productLd } from '../../../i18n/ja/schema';
import { PATHS } from '../../../i18n/ja/site';

const title = '製品';
const description = 'NEUVELIF リリーリカバリーサンクリーム（SPF50+ PA++++、75mL）と抹茶PDRN デパフィング クレンジング（300mL）。皮膚施術の前後の敏感な肌を基準につくった日焼け止めと洗顔料です。';
const jsonLd = [
  breadcrumbs(Astro.site!, [['ホーム', '/ja/'], ['製品', PATHS.products]]),
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: 'NEUVELIFの製品',
    itemListElement: [
      { '@type': 'ListItem', position: 1, url: new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + PATHS.sunscreen, Astro.site).href, name: 'リリーリカバリーサンクリーム' },
      { '@type': 'ListItem', position: 2, url: new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + PATHS.cleansing, Astro.site).href, name: '抹茶PDRN デパフィング クレンジング' },
    ],
  },
];
const LBL = "margin: 0; font-family: 'Barlow Condensed', 'Noto Sans JP', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE";
const WRAP = 'max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box';
const td = 'padding: 16px 14px; border-bottom: 1px solid #D5E0E8; vertical-align: top';
const th = 'text-align: left; padding: 16px 14px; border-bottom: 1px solid #D5E0E8; font-weight: 700; color: #12324F';
---
<Base title={title} description={description} current="products" jsonLd={jsonLd}>
<nav aria-label="現在地" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/ja/" style="color: #56626D; text-decoration: none; padding: 8px 0">ホーム</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">製品</span>
</nav>

{/* ── 자외선 차단과 순한 세안, 가장 기본부터 ── */}
<section aria-labelledby="products-page-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(48px, 6vw, 88px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 32px`}>
<div style="display: flex; flex-direction: column; gap: 14px; max-width: 820px">
<p style={LBL}>PRODUCTS</p>
<h1 id="products-page-title" style="margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.25; letter-spacing: -0.02em; color: #12324F">紫外線対策とやさしい洗顔、<br>いちばん基本から</h1>
<p style="margin: 0; font-size: 18px; color: #3C4752">皮膚施術の前後の敏感な肌を基準につくった日焼け止めとクレンジングミルクです。すべての数値はヒト試験の結果で、試験機関と条件を併記しています。</p>
</div>
<ProductCards />
</div>
</section>

{/* ── 두 제품 한눈에 보기 ── */}
<section aria-labelledby="compare-title" style="border-top: 1px solid #D5E0E8; padding: clamp(48px, 6vw, 80px) 0">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 24px`}>
<div style="display: flex; flex-direction: column; gap: 12px">
<p style={LBL}>AT A GLANCE</p>
<h2 id="compare-title" style="margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; color: #12324F">2つの製品をひと目で</h2>
</div>
<div style="overflow-x: auto; border-top: 2px solid #12324F">
<table style="width: 100%; min-width: 720px; border-collapse: collapse; font-size: 15px">
<caption class="sr-only">リリーリカバリーサンクリームと抹茶PDRN デパフィング クレンジングの比較</caption>
<thead><tr>
<th scope="col" style={`${th}; width: 18%`}>項目</th>
<th scope="col" style={`${th}; color: #1170AE`}>リリーリカバリーサンクリーム</th>
<th scope="col" style={`${th}; color: #2F5233`}>抹茶PDRN デパフィング クレンジング</th>
</tr></thead>
<tbody>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>種類</th><td style={td}>日焼け止め（紫外線吸収剤タイプ）</td><td style={td}>ミルククレンザー（洗い流す洗顔料）</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>容量</th><td style={td}>75mL</td><td style={td}>300mL</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>機能性</th><td style={td}>紫外線カット・美白・シワ改善のトリプル機能性（SPF50+ PA++++）</td><td style={td}>—</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>使い方</th><td style={td}>スキンケアの最後のステップで顔や首などに広げる。外出30分前に塗り、2〜3時間おきの塗り直しを推奨</td><td style={td}>乾いた顔に3〜4プッシュ、くるくるマッサージでなじませてから水で洗い流す</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>皮膚刺激試験</th><td style={td}>24時間パッチ 平均皮膚刺激スコア0.00、無刺激（ELID社、34名）</td><td style={td}>24時間パッチ 平均皮膚反応スコア0.00、無刺激（韓国皮膚科学研究院、31名）</td></tr>
</tbody>
</table>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href={PATHS.guide} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; background: #12324F; color: #FFFFFF; text-decoration: none; font-weight: 700">自分の施術に合う使用タイミングを見る</a>
<a href={PATHS.research} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border: 1px solid #12324F; color: #12324F; text-decoration: none; font-weight: 700">試験結果をすべて見る</a>
</div>
<p style="margin: 0; font-size: 14px; color: #56626D">購入先は各製品ページの「購入先」でご確認いただけます。韓国全国の提携薬局でもお求めいただけます。</p>
</div>
</section>
</Base>
