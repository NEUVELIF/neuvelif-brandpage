---
// 소식 (주소: /news/) — 기사 목록은 src/data/news.ts 에서 가져옵니다.
import Base from '../../layouts/Base.astro';
import { PRESS } from '../../data/news';
import { breadcrumbs } from '../../schema';
import { PATHS } from '../../site';

const title = '소식';
const description = '뉴베리프의 수상 소식과 언론 보도를 모았습니다. 2025 하반기 화해 어워드 선케어 부문 진정 카테고리 1위, 말차 디퍼핑 클렌징 밀크 출시 등.';
const jsonLd = [breadcrumbs(Astro.site!, [['홈', '/'], ['소식', PATHS.news]])];
const LBL = "margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE";
const WRAP = 'max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box';
const years = [...new Set(PRESS.map((p) => p.date.slice(0, 4)))];
const arrow = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex: none"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>';
---
<Base title={title} description={description} current="news" jsonLd={jsonLd}>
<nav aria-label="현재 위치" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/" style="color: #56626D; text-decoration: none; padding: 8px 0">홈</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">소식</span>
</nav>

{/* ── 소식 ── */}
<section aria-labelledby="news-page-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(20px, 2.5vw, 32px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 14px; max-width: 1240px`}>
<p style={LBL}>NEWS</p>
<h1 id="news-page-title" style="margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.25; letter-spacing: -0.02em; color: #12324F">소식</h1>
<p style="margin: 0; max-width: 760px; font-size: 18px; color: #3C4752">뉴베리프의 수상 소식과 언론 보도입니다. 기사 제목을 누르면 해당 언론사 페이지가 새 창으로 열립니다.</p>
</div>
</section>

{/* ── 언론 보도 ── 페이지 제목 바로 아래에 둡니다. */}
<section aria-labelledby="press-title" style="padding: 0 0 clamp(48px, 6vw, 80px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 28px`}>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 8px 24px">
<h2 id="press-title" style="margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; color: #12324F">언론 보도</h2>
<p style="margin: 0; color: #56626D">총 {PRESS.length}건</p>
</div>
{years.map((y) => (
  <div style="display: flex; flex-wrap: wrap; gap: 12px 48px">
  <h3 style="flex: 0 0 120px; margin: 0; padding-top: 18px; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 28px; font-weight: 600; color: #1170AE">{y}</h3>
  <ul style="flex: 1 1 560px; min-width: 0; list-style: none; margin: 0; padding: 0; border-top: 2px solid #12324F">
  {PRESS.filter((p) => p.date.startsWith(y)).map((p) => (
    <li style="border-bottom: 1px solid #D5E0E8">
    <a href={p.url} target="_blank" rel="noopener" class="press-row">
    <span style="flex: 0 0 auto; min-width: 150px; font-size: 14px; color: #56626D; font-variant-numeric: tabular-nums">{p.date} · {p.outlet}</span>
    <span style="flex: 1 1 240px; font-size: 17px; font-weight: 700; line-height: 1.5; color: #12324F">{p.title}<span class="sr-only"> (새 창)</span></span>
    <Fragment set:html={arrow} />
    </a>
    </li>
  ))}
  </ul>
  </div>
))}
<p style="margin: 0; font-size: 14px; color: #56626D">기사 내용은 각 언론사의 표현이며, 제품의 효능·효과를 뜻하지 않습니다. 브랜드가 걸어온 길은 <a href={`${PATHS.brand}`} style="color: #1170AE">브랜드 이야기</a>에서 보실 수 있습니다.</p>
</div>
</section>
{/* ── 수상 소식 ── 언론 보도 아래에 둡니다. */}
<section aria-labelledby="award-title" style="background: #EEF3F7; color: #12324F; padding: clamp(48px, 6vw, 80px) 0">
<div style={`${WRAP}; display: flex; flex-wrap: wrap; align-items: center; gap: 28px 64px`}>
<div style="flex: 1 1 400px; display: flex; flex-direction: column; gap: 12px">
<p style={LBL}>AWARD · 2025.11</p>
<h2 id="award-title" style="margin: 0; font-size: clamp(24px, 2.8vw, 36px); line-height: 1.35">2025 하반기 화해 어워드<br>선케어 부문(선크림/로션)<br>진정 카테고리 1위</h2>
</div>
<div style="flex: 1 1 480px; display: flex; flex-direction: column; gap: 16px">
<p style="margin: 0; font-size: 17px; color: #3C4752">백합 리커버리 선크림이 화해 사용자의 리뷰와 평점을 바탕으로 선정되는 2025 하반기 화해 어워드에서 선케어 부문(선크림/로션) 진정 카테고리 1위에 올랐습니다.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href={PATHS.sunscreen} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; background: #12324F; color: #FFFFFF; text-decoration: none; font-weight: 700">백합 리커버리 선크림 보기</a>
<a href="https://www.mydaily.co.kr/page/view/2025112015485021661" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; gap: 8px; min-height: 52px; padding: 0 24px; border: 1px solid #12324F; color: #12324F; text-decoration: none; font-weight: 700">관련 기사<span class="sr-only"> (마이데일리, 새 창)</span><Fragment set:html={arrow} /></a>
</div>
</div>
</div>
</section>

</Base>

<style>
  .press-row { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 24px; padding: 20px 4px; color: #12324F; text-decoration: none; }
  .press-row:hover { background: #F4F7FA; }
  .press-row:hover span { text-decoration: underline; text-underline-offset: 3px; }
</style>
