const faqLd = makeFaq([["Is it a chemical or a mineral sunscreen?", "It is a chemical (organic) sunscreen. It contains four UV filters: Diethylamino Hydroxybenzoyl Hexyl Benzoate, Ethylhexyl Triazone, Methylene Bis-Benzotriazolyl Tetramethylbutylphenol, and Diethylhexyl Butamido Triazone."], ["Is it a functional cosmetic?", "Yes. It was reported to Korea's Ministry of Food and Drug Safety (MFDS) in June 2025 as a triple-function cosmetic for UV protection, brightening, and wrinkle improvement. The brightening ingredient is niacinamide and the anti-wrinkle ingredient is adenosine."], ["Does it sting the eyes?", "How much you feel it varies from person to person. After 21 women who usually experience eye stinging from cosmetics used it for 2 weeks, their eye stinging score fell by 80.27%. If it gets directly into your eyes, rinse with water."], ["Can people with sensitive skin use it?", "In a 24-hour patch test (34 participants) it scored 0.00 for skin irritation and was classified as non-irritating. Skin reactions vary, though, so try it first on a small area such as behind the ear or along the jawline. If you notice any problem, stop using it and consult a dermatologist."], ["My dermatologist told me to use a mineral sunscreen. Can I use this?", "Please follow your doctor's advice. NEUVELIF Backhap Recovery Sunscreen uses chemical (organic) filters. Some clinics recommend a mineral sunscreen for a while after procedures that leave tiny channels in the skin."]]);
const product = productLd(Astro.site!, {"name": "Backhap Recovery Sunscreen", "alt": "NEUVELIF Backhap Recovery Sunscreen SPF50+ PA++++", "img": "/images/products/backhap-recovery-sunscreen-1000.jpg", "desc": "A triple-function sunscreen for UV protection, brightening, and anti-wrinkle care (SPF50+ PA++++, 75 mL). Made with sensitive skin before and after skin procedures in mind.", "award": "No. 1 in the Soothing category, Sun Care (Sunscreen/Lotion), 2025 H2 Hwahae Awards", "size": "75mL", "cat": "Sunscreen"});
const jsonLd = [product, crumbs, ...faqLd];
