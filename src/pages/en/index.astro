---
// 홈 화면 (주소: /)
// 아래로 내려가며: 소식 슬라이드 → 브랜드 소개 → 제품 → 임상 연구 요약 → 시술 그룹 → 소식 → 자주 묻는 질문
// <HeroSlider /> 처럼 대문자로 시작하는 태그는 src/components/ 의 부품을 불러온 것입니다.
import Base from '../../i18n/en/layouts/Base.astro';
import HeroSlider from '../../i18n/en/components/HeroSlider.astro';
import GroupPicker from '../../i18n/en/components/GroupPicker.astro';
import ProductCards from '../../i18n/en/components/ProductCards.astro';
import { org, website, founder, aboutPage, breadcrumbs, productLd, articleLd, faqLd as makeFaq } from '../../i18n/en/schema';
const title = "NEUVELIF | Derma skincare for before and after skin procedures";
const description = "NEUVELIF is a derma skincare brand for use before and after skin procedures such as lasers, lifting, and injections. We publish procedure-by-procedure guides on when to start sunscreen and face washing, along with clinical test results and their conditions.";
const faqLd = makeFaq([["When can I start applying sunscreen after a procedure?", "It depends on the procedure. After laser toning, IPL, or lifting, you usually apply it from the same day; after procedures that leave tiny channels, usually from 24 hours later; and after procedures that leave scabs, once the wound has healed. If your clinic's instructions differ, follow your clinic."], ["Is it a chemical or a mineral sunscreen?", "It uses chemical (organic) filters, with four UV-filtering ingredients."], ["How many pumps of the cleansing milk should I use?", "Use 3–4 pumps at a time and spread over your whole face. You can use a little more when removing heavy makeup."]]);
const jsonLd = [org, website, ...faqLd];
---
<Base title={title} description={description} current="" jsonLd={jsonLd}>
<HeroSlider />



{/* ── 나를 아끼는 마음은 피부에서 시작된다 ── */}
<section id="brand" aria-labelledby="brand-title" style="padding: clamp(56px, 7vw, 104px) 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 40px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 48px">
<div style="flex: 1 1 520px; display: flex; flex-direction: column; gap: 12px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">ABOUT NEUVELIF</p>
<h2 id="brand-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em; color: #12324F">Self-care begins<br>with your skin</h2>
<p style="margin: 0; color: #3C4752; max-width: 640px">NEUVELIF is a dermocosmetic brand focused on skincare before and after skin procedures. We introduced our first product, Backhap Recovery Sunscreen, in July 2025.</p>
</div>
<a href="/en/brand/" style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border: 1px solid #12324F; color: #12324F; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">Our story</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 24px">
<div style="flex: 1 1 300px; border-top: 3px solid #12324F; padding-top: 20px; display: flex; flex-direction: column; gap: 8px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 24px; font-weight: 600; letter-spacing: 0.06em; color: #12324F">DERMATOLOGY</p>
<p style="margin: 0; color: #3C4752">We design around how skin changes before and after procedures, matching timing of use and skin condition.</p>
</div>
<div style="flex: 1 1 300px; border-top: 3px solid #12324F; padding-top: 20px; display: flex; flex-direction: column; gap: 8px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 24px; font-weight: 600; letter-spacing: 0.06em; color: #12324F">INNOVATION</p>
<p style="margin: 0; color: #3C4752">We relentlessly solve the discomforts customers feel, and redefine the standard for our products.</p>
</div>
<div style="flex: 1 1 300px; border-top: 3px solid #12324F; padding-top: 20px; display: flex; flex-direction: column; gap: 8px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 24px; font-weight: 600; letter-spacing: 0.06em; color: #12324F">A.I.</p>
<p style="margin: 0; color: #3C4752">We analyze real-world usage data with A.I. to create formulas that solve problems.</p>
</div>
</div>
</div>
</section>

{/* ── 자외선 차단과 순한 세안, 가장 기본부터 ── */}
<section id="products" aria-labelledby="products-title" style="border-top: 1px solid #D5E0E8; padding: clamp(56px, 7vw, 104px) 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 32px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 760px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">PRODUCTS</p>
<h2 id="products-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em; color: #12324F">Sun protection and gentle cleansing: the basics first</h2>
<p style="margin: 0; color: #3C4752">All figures are clinical test results, listed with the testing institution and conditions.</p>
</div>
<a href="/en/products/" style="display: inline-flex; align-items: center; min-height: 44px; color: #1170AE; font-weight: 700; text-decoration: none; letter-spacing: 0.04em">View all products →</a>
</div>
<ProductCards />
<p style="margin: 0; font-size: 13px; color: #56626D">Clinical test results were obtained under test conditions and may vary from person to person.</p>
</div>
</section>

{/* ── 시험 결과를 조건과 함께 공개합니다 ── */}
<section id="research" aria-labelledby="research-title" style="background: #12324F; color: #FFFFFF; padding: clamp(56px, 7vw, 96px) 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 48px">
<div style="flex: 1 1 420px; display: flex; flex-direction: column; gap: 12px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #8FD3F2">CLINICAL RESEARCH</p>
<h2 id="research-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em">We publish test results with their conditions</h2>
<p style="margin: 0; color: #C9D6E2">We list the testing institution, number of participants, and measurement time next to each number. Clinical tests, non-human tests, and usage surveys are clearly distinguished.</p>
</div>
<a href="/en/research/" style="display: inline-flex; align-items: center; min-height: 44px; color: #8FD3F2; font-weight: 700; text-decoration: none; letter-spacing: 0.04em">View all clinical research →</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px">
<div style="flex: 1 1 260px; border: 1px solid #36506A; padding: 24px; display: flex; flex-direction: column; gap: 6px; background: #1A4266; border-color: #8FD3F2">
<p style="margin: 0; font-size: 44px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums">8</p>
<p style="margin: 0; color: #C9D6E2">Total tests on NEUVELIF products<br>Backhap Recovery Sunscreen: 5 · Matcha Depuffing Cleansing Milk: 3</p>
</div>
<div style="flex: 1 1 260px; border: 1px solid #36506A; padding: 24px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 44px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums">7</p>
<p style="margin: 0; color: #C9D6E2">Clinical tests (on people)</p>
</div>
<div style="flex: 1 1 260px; border: 1px solid #36506A; padding: 24px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 44px; font-weight: 700; line-height: 1.2; font-variant-numeric: tabular-nums">1</p>
<p style="margin: 0; color: #C9D6E2">Non-human test (eye irritation on a reconstructed cornea model)</p>
</div>
</div>
</div>
</section>

<GroupPicker />





{/* ── 소식 ── */}
<section id="news" aria-labelledby="news-title" style="background: #FFFFFF; border-top: 1px solid #D5E0E8; padding: clamp(56px, 7vw, 96px) 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 32px">
<div style="display: flex; flex-direction: column; gap: 12px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">NEWS</p>
<h2 id="news-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em; color: #12324F">News</h2>
</div>
<a href="/en/news/" style="display: inline-flex; align-items: center; min-height: 44px; color: #1170AE; font-weight: 700; text-decoration: none; letter-spacing: 0.04em">View all news →</a>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px">
<a href="https://www.datanet.co.kr/news/articleView.html?idxno=212180" style="flex: 1 1 300px; min-width: 0; background: #FFFFFF; border: 1px solid #D5E0E8; padding: 24px; display: flex; flex-direction: column; gap: 10px; color: #1A1F24; text-decoration: none">
<p style="margin: 0; font-size: 13px; color: #56626D">Datanet · 2026.06.08</p>
<p style="margin: 0; font-size: 17px; font-weight: 700; line-height: 1.5; color: #12324F">Dermocosmetic brand NEUVELIF partners with skin-procedure platform ‘Yeoshin Ticket’ on marketing</p>
</a>
<a href="https://www.mydaily.co.kr/page/view/2026013009490418606" style="flex: 1 1 300px; min-width: 0; background: #FFFFFF; border: 1px solid #D5E0E8; padding: 24px; display: flex; flex-direction: column; gap: 10px; color: #1A1F24; text-decoration: none">
<p style="margin: 0; font-size: 13px; color: #56626D">MyDaily · 2026.01.30</p>
<p style="margin: 0; font-size: 17px; font-weight: 700; line-height: 1.5; color: #12324F">NEUVELIF officially launches on Naver Fashion Beauty</p>
</a>
<a href="https://www.livesnews.com/news/article.html?no=52895" style="flex: 1 1 300px; min-width: 0; background: #FFFFFF; border: 1px solid #D5E0E8; padding: 24px; display: flex; flex-direction: column; gap: 10px; color: #1A1F24; text-decoration: none">
<p style="margin: 0; font-size: 13px; color: #56626D">Live News · 2025.07.31</p>
<p style="margin: 0; font-size: 17px; font-weight: 700; line-height: 1.5; color: #12324F">NEUVELIF launches its first product, Backhap Recovery Sunscreen, marking the start of wellness</p>
</a>
</div>
</div>
</section>

{/* ── 궁금한 점이 있으신가요? ── */}
<section id="faq" aria-labelledby="faq-title" style="background: #FFFFFF; border-top: 1px solid #D5E0E8; padding: clamp(56px, 7vw, 96px) 0">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-wrap: wrap; gap: 32px 64px">
<div style="flex: 1 1 300px; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">FAQ</p>
<h2 id="faq-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em; color: #12324F">Have a question?</h2>
<p style="margin: 0; color: #3C4752">We've gathered frequently asked questions, from use after procedures to ingredients and shelf life.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px">

<a href="/en/faq/" style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; border: 1px solid #12324F; color: #12324F; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">View all FAQs</a>
</div>
</div>
<div style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; border-top: 2px solid #12324F">
<div style="padding: 22px 0; border-bottom: 1px solid #D5E0E8; display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0; font-size: 18px; color: #12324F">When can I start applying sunscreen after a procedure?</h3>
<p style="margin: 0; color: #3C4752">It depends on the procedure. After laser toning, IPL, or lifting, you usually apply it from the same day; after procedures that leave tiny channels, usually from 24 hours later; and after procedures that leave scabs, once the wound has healed. If your clinic's instructions differ, follow your clinic.</p>
</div>
<div style="padding: 22px 0; border-bottom: 1px solid #D5E0E8; display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0; font-size: 18px; color: #12324F">Is it a chemical or a mineral sunscreen?</h3>
<p style="margin: 0; color: #3C4752">It uses chemical (organic) filters, with four UV-filtering ingredients.</p>
</div>
<div style="padding: 22px 0; border-bottom: 1px solid #D5E0E8; display: flex; flex-direction: column; gap: 8px">
<h3 style="margin: 0; font-size: 18px; color: #12324F">How many pumps of the cleansing milk should I use?</h3>
<p style="margin: 0; color: #3C4752">Use 3–4 pumps at a time and spread over your whole face. You can use a little more when removing heavy makeup.</p>
</div>
</div>
</div>
</section>

</Base>
