---
import Base from '../../layouts/Base.astro';
import ProductCards from '../../components/ProductCards.astro';
import { breadcrumbs, productLd } from '../../schema';
import { PATHS } from '../../site';

const title = '제품';
const description = '뉴베리프 백합 리커버리 선크림(SPF50+ PA++++, 75mL)과 말차 디퍼핑 클렌징 밀크(300mL). 피부 시술 전후의 예민한 피부를 기준으로 만든 자외선 차단제와 세안제입니다.';
const jsonLd = [
  breadcrumbs(Astro.site!, [['홈', '/'], ['제품', PATHS.products]]),
  {
    '@context': 'https://schema.org', '@type': 'ItemList', name: '뉴베리프 제품',
    itemListElement: [
      { '@type': 'ListItem', position: 1, url: new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + PATHS.sunscreen, Astro.site).href, name: '백합 리커버리 선크림' },
      { '@type': 'ListItem', position: 2, url: new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + PATHS.cleansing, Astro.site).href, name: '말차 디퍼핑 클렌징 밀크' },
    ],
  },
];
const LBL = "margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE";
const WRAP = 'max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box';
const td = 'padding: 16px 14px; border-bottom: 1px solid #D5E0E8; vertical-align: top';
const th = 'text-align: left; padding: 16px 14px; border-bottom: 1px solid #D5E0E8; font-weight: 700; color: #12324F';
---
<Base title={title} description={description} current="products" jsonLd={jsonLd}>
<nav aria-label="현재 위치" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/" style="color: #56626D; text-decoration: none; padding: 8px 0">홈</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">제품</span>
</nav>

<section aria-labelledby="products-page-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(48px, 6vw, 88px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 32px`}>
<div style="display: flex; flex-direction: column; gap: 14px; max-width: 820px">
<p style={LBL}>PRODUCTS</p>
<h1 id="products-page-title" style="margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.25; letter-spacing: -0.02em; color: #12324F">자외선 차단과 순한 세안,<br>가장 기본부터</h1>
<p style="margin: 0; font-size: 18px; color: #3C4752">피부 시술 전후의 예민한 피부를 기준으로 만든 선크림과 클렌징 밀크입니다. 모든 수치는 인체적용시험 결과이며, 시험 기관과 조건을 함께 적었습니다.</p>
</div>
<ProductCards />
</div>
</section>

<section aria-labelledby="compare-title" style="border-top: 1px solid #D5E0E8; padding: clamp(48px, 6vw, 80px) 0">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 24px`}>
<div style="display: flex; flex-direction: column; gap: 12px">
<p style={LBL}>AT A GLANCE</p>
<h2 id="compare-title" style="margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; color: #12324F">두 제품 한눈에 보기</h2>
</div>
<div style="overflow-x: auto; border-top: 2px solid #12324F">
<table style="width: 100%; min-width: 720px; border-collapse: collapse; font-size: 15px">
<caption class="sr-only">백합 리커버리 선크림과 말차 디퍼핑 클렌징 밀크 비교</caption>
<thead><tr>
<th scope="col" style={`${th}; width: 18%`}>항목</th>
<th scope="col" style={`${th}; color: #1170AE`}>백합 리커버리 선크림</th>
<th scope="col" style={`${th}; color: #2F5233`}>말차 디퍼핑 클렌징 밀크</th>
</tr></thead>
<tbody>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>종류</th><td style={td}>선크림 (유기자차)</td><td style={td}>밀크 클렌저 (씻어 내는 세안제)</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>용량</th><td style={td}>75mL</td><td style={td}>300mL</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>기능성</th><td style={td}>자외선 차단·미백·주름개선 3중 기능성 (SPF50+ PA++++)</td><td style={td}>—</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>쓰는 법</th><td style={td}>스킨케어 마지막 단계에 얼굴과 목 등에 펴 바름. 외출 30분 전, 2~3시간마다 덧바르기 권장</td><td style={td}>마른 얼굴에 3~4번 펌핑, 롤링 마사지로 풀어낸 뒤 물로 헹굼</td></tr>
<tr><th scope="row" style={`${th}; background: #F5F8FA`}>피부 자극 시험</th><td style={td}>24시간 첩포 평균 피부자극도 0.00, 무자극 (㈜엘리드, 34명)</td><td style={td}>24시간 첩포 평균 피부반응도 0.00, 무자극 (한국피부과학연구원, 31명)</td></tr>
</tbody>
</table>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a href={PATHS.guide} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; background: #12324F; color: #FFFFFF; text-decoration: none; font-weight: 700">내 시술에 맞는 사용 시점 보기</a>
<a href={PATHS.research} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 24px; border: 1px solid #12324F; color: #12324F; text-decoration: none; font-weight: 700">시험 결과 전체 보기</a>
</div>
<p style="margin: 0; font-size: 14px; color: #56626D">구매처는 각 제품 페이지의 ‘구매처’에서 확인하실 수 있습니다. 전국 제휴 약국에서도 만나실 수 있습니다.</p>
</div>
</section>
</Base>
