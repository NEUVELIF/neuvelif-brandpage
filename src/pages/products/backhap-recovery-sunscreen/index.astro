const product = productLd(Astro.site!, {"name": "백합 리커버리 선크림", "alt": "NEUVELIF Backhap Recovery Sunscreen SPF50+ PA++++", "img": "/images/products/backhap-recovery-sunscreen-1000.jpg", "desc": "자외선 차단·미백·주름개선 3중 기능성 선크림 (SPF50+ PA++++, 75mL). 피부 시술 전후의 예민한 피부를 기준으로 만들었습니다.", "award": "2025 하반기 화해 어워드 선케어 부문(선크림/로션) 진정 카테고리 1위", "size": "75mL", "cat": "선크림"});
