---
import Base from '../../../layouts/Base.astro';
import ProcedurePicker from '../../../components/ProcedurePicker.astro';
import WhereToBuy from '../../../components/WhereToBuy.astro';
import { org, website, founder, aboutPage, breadcrumbs, productLd, articleLd, faqLd as makeFaq } from '../../../schema';
const title = "레이저 토닝·IPL·리프팅 후 선크림·세안 가이드";
const description = "울쎄라·슈링크, 써마지·인모드·올리지오, 티타늄 리프팅, 레이저 토닝, IPL 등 7가지 시술 뒤 선크림과 클렌징을 언제부터 어떻게 쓰면 좋은지 시술별로 정리했습니다.";
const crumbs = breadcrumbs(Astro.site!, [["홈", "/"], ["시술별 가이드", "/#guide"], ["레이저 토닝·IPL·리프팅", "/guide/laser-ipl-lifting/"]]);
const faqLd = makeFaq([["시술 후 선크림은 언제부터 바르나요?", "시술 종류에 따라 다릅니다. 피부 표면이 열리지 않는 레이저 토닝·IPL·리프팅은 보통 당일부터, 미세한 구멍이 남는 시술은 보통 24시간 뒤부터, 딱지가 생기는 시술은 상처가 아문 뒤부터 바릅니다. 시술한 병원의 안내가 다르면 병원 안내를 따르세요."], ["시술 후 세안은 언제부터 클렌징 밀크로 하나요?", "병원이 세안을 허락한 시점부터 씁니다. 레이저 토닝·IPL·리프팅은 보통 당일 저녁부터 미온수로 가볍게, 주사 시술은 병원이 안내한 시간이 지난 뒤 마사지 없이 씁니다."], ["피부과에서 무기자차를 쓰라고 했어요. 뉴베리프 선크림을 써도 되나요?", "의료진의 안내를 따르세요. 뉴베리프 백합 리커버리 선크림은 유기자차입니다. 일부 의료기관은 미세한 구멍이 남는 시술 뒤 일정 기간 무기자차를 권합니다."]]);
const article = articleLd(Astro.site!, { headline: title, description, path: '/guide/laser-ipl-lifting/', modified: '2026-11-08' });
const jsonLd = [article, crumbs, ...faqLd];
---
<Base title={title} description={description} current="guide" jsonLd={jsonLd} buyHref="#buy">
<nav aria-label="현재 위치" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/" style="color: #56626D; text-decoration: none; padding: 8px 0">홈</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<a href="/#guide" style="color: #56626D; text-decoration: none; padding: 8px 0">시술별 가이드</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">레이저 토닝·IPL·리프팅</span>
</nav>

<section aria-labelledby="guide-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(40px, 5vw, 64px)">
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 28px">

<nav aria-label="시술 그룹" style="display: flex; flex-wrap: wrap; gap: 10px">
