---
// 자주 묻는 질문 (주소: /faq/)
import Base from '../../layouts/Base.astro';
import faq from '../../data/faq.json';
import { breadcrumbs, faqLd } from '../../schema';
import { PATHS } from '../../site';

const title = '자주 묻는 질문';
const description = '피부 시술 후 선크림·세안 시점, 백합 리커버리 선크림과 말차 디퍼핑 클렌징 밀크의 성분·사용법·사용기한, 구매와 문의까지 뉴베리프에 자주 묻는 질문을 모았습니다.';
// 질문 원본은 src/data/faq.json 에 있습니다. (JSON = 데이터를 적는 형식, 주석을 넣을 수 없음)
// flatMap: 네 묶음의 질문을 한 줄 목록으로 펼칩니다 (구조화 데이터용).
const all = faq.flatMap((c) => c.items.map((it) => [it.q, it.a] as [string, string]));
const jsonLd = [breadcrumbs(Astro.site!, [['홈', '/'], ['자주 묻는 질문', PATHS.faq]]), ...faqLd(all)];
const LBL = "margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE";
const WRAP = 'max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box';
const total = all.length;
---
<Base title={title} description={description} jsonLd={jsonLd}>
<nav aria-label="현재 위치" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/" style="color: #56626D; text-decoration: none; padding: 8px 0">홈</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">자주 묻는 질문</span>
</nav>

{/* ── 자주 묻는 질문 ── */}
<section aria-labelledby="faq-page-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(24px, 3vw, 40px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 20px`}>
<div style="display: flex; flex-direction: column; gap: 14px; max-width: 820px">
<p style={LBL}>FAQ</p>
<h1 id="faq-page-title" style="margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.25; letter-spacing: -0.02em; color: #12324F">자주 묻는 질문</h1>
<p style="margin: 0; font-size: 18px; color: #3C4752">시술 후 사용법부터 성분, 사용기한까지 {total}가지 질문에 답했습니다. 답은 시험 결과와 제품 표시사항을 근거로 썼습니다.</p>
</div>
<nav aria-label="질문 분류" style="display: flex; flex-wrap: wrap; gap: 10px">
{faq.map((c) => (
  <a href={`#${c.key}`} style="display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px; border: 1px solid #B9C9D6; color: #12324F; text-decoration: none; font-size: 15px; font-weight: 500">{c.label}<span style="font-size: 13px; color: #56626D">{c.items.length}</span></a>
))}
</nav>
</div>
</section>

{faq.map((c) => (
<section id={c.key} aria-labelledby={`${c.key}-title`} style="border-top: 1px solid #D5E0E8; padding: clamp(40px, 5vw, 64px) 0; scroll-margin-top: 16px">
<div style={`${WRAP}; display: flex; flex-wrap: wrap; gap: 24px 64px`}>
<div style="flex: 1 1 260px; display: flex; flex-direction: column; gap: 8px">
<h2 id={`${c.key}-title`} style="margin: 0; font-size: clamp(22px, 2.4vw, 28px); line-height: 1.3; color: #12324F">{c.label}</h2>
<p style="margin: 0; color: #56626D">{c.items.length}개 질문</p>
</div>
<div class="faq-list" style="flex: 999 1 640px; min-width: 0; border-top: 2px solid #12324F">
{c.items.map((it) => (
  <details id={it.id}>
  <summary><h3>{it.q}</h3><span aria-hidden="true" class="faq-icon"></span></summary>
  <p>{it.a}</p>
  </details>
))}
</div>
</div>
</section>
))}

{/* ── 찾는 답이 없나요? ── */}
<section aria-labelledby="faq-more-title" style="background: #12324F; color: #FFFFFF; padding: clamp(40px, 5vw, 64px) 0">
<div style={`${WRAP}; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 20px 48px`}>
<div style="display: flex; flex-direction: column; gap: 8px">
<h2 id="faq-more-title" style="margin: 0; font-size: clamp(22px, 2.4vw, 28px)">찾는 답이 없나요?</h2>
<p style="margin: 0; color: #C9D6E2">이메일로 문의해 주시면 신속하게 답변을 드리겠습니다.</p>
</div>
<a href={PATHS.contact} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; background: #FFFFFF; color: #12324F; text-decoration: none; font-weight: 700">문의하기</a>
</div>
</section>
</Base>

<style>
  .faq-list details { border-bottom: 1px solid #D5E0E8; scroll-margin-top: 16px; }
  .faq-list summary { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 20px 0; cursor: pointer; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list h3 { margin: 0; font-size: 17px; line-height: 1.5; color: #12324F; }
  .faq-list p { margin: 0; padding: 0 40px 22px 0; color: #3C4752; line-height: 1.8; }
  .faq-icon { flex: none; position: relative; width: 16px; height: 16px; }
  .faq-icon::before, .faq-icon::after { content: ''; position: absolute; left: 0; top: 7px; width: 16px; height: 2px; background: #1170AE; transition: transform 0.2s; }
  .faq-icon::after { transform: rotate(90deg); }
  details[open] .faq-icon::after { transform: rotate(0deg); }
  .faq-list summary:hover h3 { color: #1170AE; }
</style>

<script>
  // 주소 끝에 #s-04 처럼 질문 번호가 있으면 그 질문을 펼쳐 줍니다.
  const open = () => { const el = location.hash && document.getElementById(location.hash.slice(1)); if (el && el.tagName === 'DETAILS') (el as HTMLDetailsElement).open = true; };
  open(); window.addEventListener('hashchange', open);
</script>
