---
import Base from '../../layouts/Base.astro';
import { TESTS } from '../../data/research';
import { breadcrumbs } from '../../schema';
import { PATHS } from '../../site';

const title = '임상 연구: 인체적용시험 결과와 조건';
const description = '뉴베리프 백합 리커버리 선크림과 말차 디퍼핑 클렌징 밀크가 받은 시험 8건(인체적용시험 7건, 비인체 시험 1건)의 결과를 시험 기관, 기간, 대상, 방법과 함께 공개합니다. SPF 53.9, UVAPF 18.6, 24시간 첩포 피부자극도 0.00 등.';
const jsonLd = [breadcrumbs(Astro.site!, [['홈', '/'], ['임상 연구', PATHS.research]])];
const LBL = "margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE";
const WRAP = 'max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box';
const td = 'padding: 14px 12px; border-bottom: 1px solid #D5E0E8; vertical-align: top';
const th = 'text-align: left; padding: 14px 12px; border-bottom: 1px solid #D5E0E8; font-weight: 700; color: #12324F';
const groups = [
  { key: 'sunscreen', name: '백합 리커버리 선크림', color: '#1170AE', page: PATHS.sunscreen },
  { key: 'cleansing', name: '말차 디퍼핑 클렌징 밀크', color: '#2F5233', page: PATHS.cleansing },
] as const;
const total = TESTS.length;
const human = TESTS.filter((t) => t.human).length;
const sunCount = TESTS.filter((t) => t.product === 'sunscreen').length;
const cleanCount = TESTS.filter((t) => t.product === 'cleansing').length;
const surveys = {
  sunscreen: { who: '피부 진정 시험에 참여한 여성 22명, 바른 직후, 6단계 중 ‘그런 편이다’ 이상', rows: [['피부결이 매끄럽게 정돈된 느낌', '100%'], ['자극 없이 부드럽게 퍼지는 느낌', '100%'], ['속부터 촉촉해진 느낌', '100%'], ['다른 화장품과 밀림 없이 어우러짐', '100%'], ['유분감 없이 자연스럽게 흡수', '100%'], ['백탁 없이 깨끗한 마무리', '95.5%']] },
  cleansing: { who: '효능 시험에 참여한 여성 22명, 1회 사용 직후, ‘그렇다’ 이상', rows: [['세안 후 당기지 않고 촉촉하게 유지', '100%'], ['잔여감 없이 말끔한 마무리', '100%'], ['세정력에 만족', '100%'], ['촉촉함에 만족', '100%']] },
};
---
<Base title={title} description={description} current="research" jsonLd={jsonLd}>
<nav aria-label="현재 위치" style="max-width: 1240px; margin: 0 auto; padding: 16px clamp(20px, 4vw, 48px) 0; box-sizing: border-box; font-size: 13px; color: #56626D">
<a href="/" style="color: #56626D; text-decoration: none; padding: 8px 0">홈</a>
<span aria-hidden="true" style="padding: 0 8px">›</span>
<span aria-current="page" style="color: #12324F; font-weight: 500">임상 연구</span>
</nav>

<section aria-labelledby="research-page-title" style="padding: clamp(24px, 3vw, 40px) 0 clamp(40px, 5vw, 64px)">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 28px`}>
<div style="display: flex; flex-direction: column; gap: 14px; max-width: 860px">
<p style={LBL}>CLINICAL RESEARCH</p>
<h1 id="research-page-title" style="margin: 0; font-size: clamp(30px, 3.4vw, 44px); line-height: 1.25; letter-spacing: -0.02em; color: #12324F">시험 결과를 조건과 함께 공개합니다</h1>
<p style="margin: 0; font-size: 18px; color: #3C4752">뉴베리프는 제품마다 외부 시험기관에 시험을 맡기고, 숫자 옆에 시험 기관과 인원, 측정 시점을 함께 적습니다. 인체적용시험과 비인체 시험, 사용감 설문은 서로 구분해 표시합니다.</p>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px">
<div style="background: #12324F; color: #FFFFFF; padding: 26px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 48px; font-weight: 700; line-height: 1.15">{total}건</p>
<p style="margin: 0; color: #C9D6E2">뉴베리프 제품이 받은 시험 합계<br>백합 리커버리 선크림 {sunCount}건 · 말차 디퍼핑 클렌징 밀크 {cleanCount}건</p>
</div>
<div style="border: 1px solid #D5E0E8; padding: 26px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 48px; font-weight: 700; line-height: 1.15; color: #12324F">{human}건</p>
<p style="margin: 0; color: #3C4752">인체적용시험 (사람 대상)</p>
</div>
<div style="border: 1px solid #D5E0E8; padding: 26px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 48px; font-weight: 700; line-height: 1.15; color: #12324F">{total - human}건</p>
<p style="margin: 0; color: #3C4752">비인체 시험 (인공 각막 모델)</p>
</div>
<div style="border: 1px solid #D5E0E8; padding: 26px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 48px; font-weight: 700; line-height: 1.15; color: #12324F">0건</p>
<p style="margin: 0; color: #3C4752">보고된 이상반응</p>
</div>
</div>
</div>
</section>

<section aria-labelledby="summary-title" style="border-top: 1px solid #D5E0E8; padding: clamp(48px, 6vw, 80px) 0">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 24px`}>
<div style="display: flex; flex-direction: column; gap: 12px">
<p style={LBL}>AT A GLANCE</p>
<h2 id="summary-title" style="margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; color: #12324F">시험 {total}건 한눈에 보기</h2>
</div>
<div style="overflow-x: auto; border-top: 2px solid #12324F">
<table style="width: 100%; min-width: 860px; border-collapse: collapse; font-size: 15px">
<caption class="sr-only">뉴베리프 제품 시험 결과 요약</caption>
<thead><tr>
<th scope="col" style={th}>제품</th><th scope="col" style={th}>시험</th><th scope="col" style={th}>결과</th><th scope="col" style={th}>시험 기관</th><th scope="col" style={th}>대상 · 시기</th>
</tr></thead>
<tbody>
{TESTS.map((t) => (
  <tr>
  <td style={`${td}; white-space: nowrap; color: ${t.product === 'sunscreen' ? '#1170AE' : '#2F5233'}; font-weight: 700`}>{t.product === 'sunscreen' ? '선크림' : '클렌징 밀크'}</td>
  <th scope="row" style={`${th}; background: #F5F8FA; font-weight: 500`}>{t.name}</th>
  <td style={`${td}; font-weight: 700; color: #12324F`}>{t.results ? t.results.map(([l, v]) => <span style="display: block; font-weight: 500"><span style="color: #56626D">{l}</span> {v}</span>) : t.result}</td>
  <td style={td}>{t.org}</td>
  <td style={td}>{t.subjects} · {t.period}</td>
  </tr>
))}
</tbody>
</table>
</div>
</div>
</section>

{groups.map((gr) => (
<section id={gr.key} aria-labelledby={`${gr.key}-title`} style="border-top: 1px solid #D5E0E8; padding: clamp(48px, 6vw, 80px) 0">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 24px`}>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 32px">
<div style="display: flex; flex-direction: column; gap: 10px">
<p style={`${LBL}; color: ${gr.color}`}>{gr.key === 'sunscreen' ? 'SUNSCREEN' : 'CLEANSING MILK'}</p>
<h2 id={`${gr.key}-title`} style="margin: 0; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.3; color: #12324F">{gr.name}</h2>
</div>
<a href={`${gr.page}#tests`} style={`display: inline-flex; align-items: center; min-height: 44px; color: ${gr.color}; font-weight: 700; text-decoration: none`}>제품 페이지에서 그래프로 보기 →</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(360px, 100%), 1fr)); gap: 16px">
{TESTS.filter((t) => t.product === gr.key).map((t) => (
  <article style={`border: 1px solid #D5E0E8; border-top: 3px solid ${t.human ? gr.color : '#8FA3B5'}; ${t.human ? '' : 'border-style: dashed; border-top-style: solid;'} padding: 24px; display: flex; flex-direction: column; gap: 10px`}>
  <p style="margin: 0; font-size: 14px; font-weight: 700; color: #56626D">{t.human ? '인체적용시험' : '비인체 시험'}</p>
  <h3 style="margin: 0; font-size: 18px; color: #12324F">{t.name}</h3>
  {t.results
    ? <ul style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 6px">{t.results.map(([l, v]) => <li style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 4px 12px; padding: 8px 0; border-bottom: 1px solid #EEF2F5"><span style="color: #3C4752">{l}</span><strong style="color: #12324F">{v}</strong></li>)}</ul>
    : <p style={`margin: 0; font-size: 36px; font-weight: 700; line-height: 1.2; color: ${gr.color}`}>{t.result}</p>}
  <p style="margin: 0; color: #3C4752">{t.detail}</p>
  <dl style="margin: 4px 0 0; display: grid; grid-template-columns: auto 1fr; gap: 4px 12px; font-size: 14px; color: #56626D">
  <dt style="font-weight: 700">기관</dt><dd style="margin: 0">{t.org}</dd>
  <dt style="font-weight: 700">시기</dt><dd style="margin: 0">{t.period}</dd>
  <dt style="font-weight: 700">대상</dt><dd style="margin: 0">{t.subjects}</dd>
  <dt style="font-weight: 700">방법</dt><dd style="margin: 0">{t.method}</dd>
  </dl>
  </article>
))}
</div>
<div style="border: 1px solid #D5E0E8; padding: 22px; display: flex; flex-direction: column; gap: 10px">
<h3 style="margin: 0; font-size: 17px; color: #12324F">사용감 설문 <span style="font-size: 14px; font-weight: 500; color: #56626D">· 기기 측정이 아니라 참여자 본인의 느낌입니다 ({surveys[gr.key].who})</span></h3>
<ul style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 4px 24px">
{surveys[gr.key].rows.map(([q, v]) => <li style="display: flex; justify-content: space-between; gap: 12px; padding: 8px 0; border-bottom: 1px solid #EEF2F5"><span style="color: #3C4752">{q}</span><strong style="color: #12324F">{v}</strong></li>)}
</ul>
</div>
</div>
</section>
))}

<section aria-labelledby="note-title" style="background: #F4F7FA; padding: clamp(40px, 5vw, 64px) 0">
<div style={`${WRAP}; display: flex; flex-direction: column; gap: 12px`}>
<h2 id="note-title" style="margin: 0; font-size: 20px; color: #12324F">결과를 읽을 때 알아 두세요</h2>
<ul style="margin: 0; padding-left: 20px; color: #3C4752; display: flex; flex-direction: column; gap: 6px">
<li>결과는 시험 조건에서 얻은 값이며, 개인에 따라 차이가 있을 수 있습니다.</li>
<li>시술 직후 피부에서 한 시험이 아닙니다. 시술 뒤 사용 시점은 시술별 가이드와 병원 안내를 따르세요.</li>
<li>눈 자극 시험은 사람이 아닌 세포 모델로 한 시험이라 인체적용시험과 구분해 표시했습니다.</li>
<li>시험기관의 결과보고서 원문은 공개하지 않고, 기관·기간·대상·방법·결과를 요약해 싣습니다.</li>
</ul>
</div>
</section>
</Base>
