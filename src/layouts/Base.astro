---
// ────────────────────────────────────────────────────────────────
// 모든 페이지가 함께 쓰는 '틀(레이아웃)'
// <head>(제목·설명·공유 정보), 머리 부분, 바닥 부분을 한 번만 만들어 두고
// 각 페이지는 가운데 내용만 채웁니다.
//
// .astro 파일에서 맨 위 --- 와 --- 사이는 '미리 실행되는 코드'입니다.
// 사이트를 만들 때 한 번 실행되고, 방문자의 브라우저에는 결과(HTML)만 갑니다.
// ────────────────────────────────────────────────────────────────
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { STAGING, BRAND, VERIFY } from '../site';
import '../styles/global.css';

// Props: 이 틀을 쓰는 페이지가 넘겨줄 수 있는 값들의 목록입니다.
// 이름 뒤 ? 가 붙은 값은 넘기지 않아도 됩니다.
interface Props {
  title: string;
  description: string;
  current?: 'brand' | 'products' | 'guide' | 'research' | 'news' | '';
  image?: string;          // 공유 미리보기 이미지 (사이트 안 경로)
  ogType?: 'website' | 'article' | 'product';
  jsonLd?: object[];       // 검색엔진·AI가 읽는 구조화 데이터
  noindex?: boolean;       // true 면 이 페이지만 검색 결과에 나오지 않게 함 (예: 404 페이지)
}
// Astro.props 로 페이지가 넘겨준 값을 꺼냅니다. = 뒤는 값이 없을 때 쓰는 기본값입니다.
const { title, description, current = '', image = '/images/products/backhap-recovery-sunscreen-1000.jpg', ogType = 'website', jsonLd = [], noindex = false } = Astro.props;
// canonical: '이 페이지의 대표 주소'를 검색엔진에 알려 주는 값
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(import.meta.env.BASE_URL.replace(/\/$/, '') + image, Astro.site).href;
// 브라우저 탭과 검색 결과에 보이는 제목. 페이지 제목 뒤에 브랜드 이름을 붙입니다.
const fullTitle = title.includes(BRAND.name) || title.includes(BRAND.nameEn) ? title : BRAND.name === BRAND.nameEn ? `${title} | ${BRAND.nameEn}` : `${title} | ${BRAND.name} ${BRAND.nameEn}`;
// 언어: 주소가 /en/ 으로 시작하면 영어, /ja/ 면 일본어, 나머지는 한국어
const path = Astro.url.pathname;
const lang = path.startsWith('/en/') ? 'en' : path.startsWith('/ja/') ? 'ja' : 'ko';
const rest = path.replace(/^\/(en|ja)(?=\/)/, '');
const alt = (p: string) => new URL(p, Astro.site).href;
const locale = { ko: 'ko_KR', en: 'en_US', ja: 'ja_JP' }[lang];
const font = lang === 'ja' ? 'Noto+Sans+JP' : 'Noto+Sans+KR';
---
<!doctype html>
<html lang={lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{fullTitle}</title>
<meta name="description" content={description}>
{!noindex && <link rel="canonical" href={canonical}>}
{!noindex && <link rel="alternate" hreflang="ko" href={alt(rest)}>}
{!noindex && <link rel="alternate" hreflang="en" href={alt(`/en${rest}`)}>}
{!noindex && <link rel="alternate" hreflang="ja" href={alt(`/ja${rest}`)}>}
{!noindex && <link rel="alternate" hreflang="x-default" href={alt(rest)}>}
{/* 임시 주소 모드일 때만 '검색 결과에 넣지 말라'는 표시를 넣습니다. {조건 && 내용} = 조건이 참일 때만 내용 표시 */}
{(STAGING || noindex) && <meta name="robots" content="noindex, nofollow">}
{!STAGING && VERIFY.bing && <meta name="msvalidate.01" content={VERIFY.bing}>}
{!STAGING && VERIFY.naver && <meta name="naver-site-verification" content={VERIFY.naver}>}
{/* og: 로 시작하는 줄 = 카카오톡·SNS에 링크를 붙였을 때 보이는 미리보기 정보 */}
<meta property="og:site_name" content={BRAND.name === BRAND.nameEn ? BRAND.nameEn : `${BRAND.name} ${BRAND.nameEn}`}>
<meta property="og:locale" content={locale}>
<meta property="og:type" content={ogType === 'product' ? 'website' : ogType}>
<meta property="og:title" content={fullTitle}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={ogImage}>
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<meta name="theme-color" content="#12324F">
{/* 구글 폰트(Noto Sans KR, Barlow Condensed)를 불러옵니다 */}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous">
<link href={`https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600&family=${font}:wght@400;500;700&display=swap`} rel="stylesheet">
{/* 구조화 데이터(JSON-LD): 검색엔진·AI가 '회사·제품·질문과 답'을 정확히 이해하도록 넣는 정보. 화면에는 보이지 않습니다. */}
{jsonLd.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
</head>
<body>
{/* 키보드로 이동하는 분이 메뉴를 건너뛰고 본문으로 바로 갈 수 있게 하는 링크 (Tab 키를 누르면 나타남) */}
<a class="skip" href="#main">본문으로 건너뛰기</a>
<div style="width: 100%; background: #FFFFFF; color: #1A1F24; font-family: 'Noto Sans KR', system-ui, -apple-system, sans-serif; font-size: 16px; line-height: 1.6; -webkit-font-smoothing: antialiased">
<Header current={current} />
<main id="main">
{/* <slot /> 자리에 각 페이지의 내용이 들어갑니다 */}
<slot />
</main>
<Footer />
</div>
</body>
</html>
