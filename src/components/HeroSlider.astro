---
// 홈 맨 위 소식 슬라이드. 모든 슬라이드 내용이 HTML에 들어 있어 검색엔진·AI도 읽을 수 있습니다.
import { SLIDES } from '../data/home';
// 슬라이드 내용은 src/data/home.ts 의 SLIDES 에 있습니다. 문구를 바꾸려면 그 파일을 고치세요.
const n = SLIDES.length;   // 슬라이드 개수
const btn = 'width: 44px; height: 44px; border: 1px solid #5B7590; background: transparent; color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; cursor: pointer';
---
<section class="hero" aria-roledescription="carousel" aria-label="뉴베리프 업데이트 소식" style="position: relative; background: #12324F; color: #FFFFFF; overflow: hidden">
<h1 class="sr-only">뉴베리프 NEUVELIF, 시술 전후의 피부를 위한 더마 스킨케어</h1>
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 104px) clamp(20px, 4vw, 48px) clamp(28px, 3.5vw, 44px); box-sizing: border-box; min-height: clamp(480px, 40vw, 600px); display: flex; flex-direction: column; justify-content: space-between; gap: 40px">
{/* 슬라이드 4장을 모두 HTML로 만들고, 첫 장 말고는 hidden(숨김)으로 둡니다. */}
<div aria-live="polite">
{SLIDES.map((s, i) => (
  <div data-slide={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${n}: ${s.kind}`} hidden={i !== 0} style="max-width: 100%; display: flex; flex-direction: column; gap: 22px">
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px">
  <span style="border: 1px solid #8FD3F2; color: #8FD3F2; padding: 4px 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em">{s.kind}</span>
  {s.date && <span style="font-size: 14px; color: #C9D6E2; font-variant-numeric: tabular-nums">{s.date}</span>}
  </div>
  <p style="margin: 0; font-size: clamp(32px, 4.4vw, 60px); line-height: 1.22; font-weight: 700; letter-spacing: -0.02em">{s.title1}{s.title2 && <><br>{s.title2}</>}</p>
  <p style="margin: 0; font-size: clamp(16px, 1.4vw, 19px); color: #D5E3EE; max-width: 860px">{s.desc}</p>
  {s.note && <p style="margin: 0; font-size: 13px; color: #A9BACB">{s.note}</p>}
  <div style="display: flex; flex-wrap: wrap; gap: 12px">
  <a href={s.href1} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; background: #FFFFFF; color: #12324F; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">{s.cta1}</a>
  <a href={s.href2} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border: 1px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">{s.cta2}</a>
  </div>
  </div>
))}
</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px">
<button type="button" data-prev aria-label="이전 소식" style={btn}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
<div style="display: flex; align-items: center">
{SLIDES.map((s, i) => (
  <button type="button" data-dot={i} aria-label={`${i + 1}번째 소식: ${s.kind}`} aria-current={i === 0 ? 'true' : undefined} style="width: 44px; height: 44px; padding: 0; border: 0; background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center"><span style={`display: block; width: 30px; height: 4px; background: ${i === 0 ? '#FFFFFF' : '#5B7590'}`}></span></button>
))}
</div>
<button type="button" data-next aria-label="다음 소식" style={btn}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
<p data-counter style="margin: 0 0 4px; font-size: 14px; color: #C9D6E2; font-variant-numeric: tabular-nums">1 / {n}</p>
</div>
</div>
</section>

<script>
  // 이전·다음·점 버튼을 누르면 해당 슬라이드만 보이게 바꿉니다.
  // cur = 지금 보이는 슬라이드 번호(0부터 시작)
  const root = document.querySelector<HTMLElement>('section.hero');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const counter = root.querySelector('[data-counter]');
    let cur = 0;
    // show(i): i번째 슬라이드만 보이게 하고, 점 표시와 '1 / 4' 숫자를 맞춥니다.
    // (i + 개수) % 개수 → 마지막에서 '다음'을 누르면 처음으로 돌아가게 하는 계산
    const show = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => (s.hidden = k !== cur));
      dots.forEach((d, k) => {
        if (k === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
        (d.firstElementChild as HTMLElement).style.background = k === cur ? '#FFFFFF' : '#5B7590';
      });
      if (counter) counter.textContent = `${cur + 1} / ${slides.length}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(cur - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(cur + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
  }
</script>
