---
// 홈 맨 위 큰 배너(히어로 슬라이더). 모든 슬라이드 내용이 HTML에 들어 있어 검색엔진·AI도 읽을 수 있습니다.
import { SLIDES } from '../data/home';
// 슬라이드 내용은 src/data/home.ts 의 SLIDES 에 있습니다. 문구를 바꾸려면 그 파일을 고치세요.
const n = SLIDES.length;   // 슬라이드 개수
// 자동 넘김 간격(밀리초). 8000 = 8초. 이 숫자만 바꾸면 넘어가는 속도가 바뀝니다.
const INTERVAL_MS = 8000;
const btn = 'width: 44px; height: 44px; border: 1px solid #5B7590; background: transparent; color: #FFFFFF; display: inline-flex; align-items: center; justify-content: center; cursor: pointer';
---
{/* --dur 값을 CSS가 받아서 진행 막대가 채워지는 시간으로 씁니다. */}
<section class="hero" aria-roledescription="carousel" aria-label="뉴베리프 업데이트 소식" style={`--dur: ${INTERVAL_MS}ms; position: relative; background: #12324F; color: #FFFFFF; overflow: hidden`}>
<h1 class="sr-only">뉴베리프 NEUVELIF, 시술 전후의 피부를 위한 더마 스킨케어</h1>
{/* ── 배경 이미지 ── 이미지가 있는 슬라이드만 만들고, 그 슬라이드가 보일 때만 함께 보입니다.
     <picture>: 화면이 좁으면(760px 이하) 휴대폰용(-mo-), 넓으면 PC용(-pc-) 파일을 브라우저가 골라 받습니다.
     srcset의 1280w·2048w 처럼 크기를 여러 개 주면 화면에 맞는 크기만 내려받아 빠릅니다.
     alt="" : 글자 없는 장식용 배경이라 화면낭독기가 읽지 않게 비워 둡니다. */}
{SLIDES.map((s, i) => s.img && (
  <picture class="bg" data-bg={i} hidden={i !== 0}>
    <source media="(max-width: 760px)" srcset={`/images/hero/${s.img}-mo-800.webp 800w, /images/hero/${s.img}-mo-1448.webp 1448w`} sizes="100vw" width="1448" height="1086" />
    <img src={`/images/hero/${s.img}-pc-2048.webp`} srcset={`/images/hero/${s.img}-pc-1280.webp 1280w, /images/hero/${s.img}-pc-2048.webp 2048w`} sizes="100vw" width="2048" height="768" alt="" loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />
  </picture>
))}
<div style="position: relative; max-width: 1240px; margin: 0 auto; padding: clamp(48px, 7vw, 104px) clamp(20px, 4vw, 48px) clamp(28px, 3.5vw, 44px); box-sizing: border-box; min-height: clamp(480px, 40vw, 600px); display: flex; flex-direction: column; justify-content: space-between; gap: 40px">
{/* ── 슬라이드 ── 모든 장을 HTML로 만들어 같은 자리에 겹쳐 두고, data-active 가 붙은 장만 보이게 합니다. */}
<div class="slides" data-slides aria-live="polite">
{SLIDES.map((s, i) => (
  <div data-slide={i} role="group" aria-roledescription="slide" aria-label={`${i + 1} / ${n}: ${s.kind}`} data-active={i === 0 ? 'true' : undefined} style="max-width: 100%; display: flex; flex-direction: column; gap: 22px">
  <div style="display: flex; flex-wrap: wrap; align-items: center; gap: 10px">
  <span style="border: 1px solid #8FD3F2; color: #8FD3F2; padding: 4px 12px; font-size: 13px; font-weight: 700; letter-spacing: 0.06em">{s.kind}</span>
  {s.date && <span style="font-size: 14px; color: #C9D6E2; font-variant-numeric: tabular-nums">{s.date}</span>}
  </div>
  <p style="margin: 0; font-size: clamp(32px, 4.4vw, 60px); line-height: 1.22; font-weight: 700; letter-spacing: -0.02em">{s.title1}{s.title2 && <><br>{s.title2}</>}</p>
  <p style="margin: 0; font-size: clamp(16px, 1.4vw, 19px); color: #D5E3EE; max-width: 860px">{s.desc}</p>
  {s.note && <p style="margin: 0; font-size: 13px; color: #A9BACB">{s.note}</p>}
  <div style="display: flex; flex-wrap: wrap; gap: 12px">
  <a href={s.href1} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; background: #FFFFFF; color: #12324F; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">{s.cta1}</a>
  <a href={s.href2} style="display: inline-flex; align-items: center; min-height: 52px; padding: 0 26px; border: 1px solid #FFFFFF; color: #FFFFFF; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">{s.cta2}</a>
  </div>
  </div>
))}
</div>
{/* ── 조작 버튼 ── 이전 · 점(진행 막대) · 다음 · 멈춤/재생 · 번호 */}
<div class="ctrl">
<button type="button" data-prev aria-label="이전 소식" style={btn}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"></path></svg></button>
<div style="display: flex; align-items: center">
{SLIDES.map((s, i) => (
  <button type="button" data-dot={i} aria-label={`${i + 1}번째 소식: ${s.kind}`} aria-current={i === 0 ? 'true' : undefined} class="dot"><span class="bar"><span class="fill"></span></span></button>
))}
</div>
<button type="button" data-next aria-label="다음 소식" style={btn}><svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"></path></svg></button>
{/* 멈춤/재생 버튼: 자바스크립트가 켜질 때만 보이도록 처음엔 hidden */}
<button type="button" data-toggle hidden aria-label="자동 넘김 멈추기" style={btn}>
  <svg data-icon-pause aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14"></rect><rect x="14" y="5" width="4" height="14"></rect></svg>
  <svg data-icon-play hidden aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
</button>
<p data-counter style="margin: 0 0 4px; font-size: 14px; color: #C9D6E2; font-variant-numeric: tabular-nums">1 / {n}</p>
</div>
</div>
</section>

<style>
  /* 배경 이미지: 배너 전체를 덮고(position: absolute; inset: 0) 글자 뒤에 깔립니다.
     object-fit: cover → 화면 비율이 달라도 찌그러지지 않고, 넘치는 가장자리만 잘립니다. */
  .bg { position: absolute; inset: 0; display: block; }
  .bg img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: center; }
  /* 슬라이드를 모두 같은 칸(grid-area: 1 / 1)에 겹쳐 둡니다.
     그러면 배너 높이가 가장 긴 슬라이드에 맞춰 고정되어, 넘어갈 때 아래 내용이 들썩이지 않습니다.
     지금 장이 아닌 슬라이드는 visibility: hidden 으로 안 보이게(자리만 차지) 합니다. */
  .slides { display: grid; }
  .slides > [data-slide] { grid-area: 1 / 1; }
  .slides > [data-slide]:not([data-active]) { visibility: hidden; }
  /* 조작 버튼 줄. 휴대폰처럼 좁은 화면(480px 이하)에서는 간격과 점 크기를 줄여 한 줄에 들어가게 합니다. */
  .ctrl { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 16px; }
  .dot { width: 44px; height: 44px; padding: 0; border: 0; background: transparent; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  @media (max-width: 480px) {
    .ctrl { gap: 8px; }
    .dot { width: 30px; }
    .dot .bar { width: 22px; }
  }
  /* 점 하나 = 회색 막대(.bar) 안에 흰 막대(.fill)가 겹쳐 있는 구조 */
  .bar { position: relative; display: block; width: 30px; height: 4px; background: #5B7590; overflow: hidden; }
  .fill { position: absolute; inset: 0; background: #FFFFFF; transform: scaleX(0); transform-origin: left center; }
  /* 지금 보이는 슬라이드의 점은 흰색으로 꽉 채움 */
  [aria-current='true'] .fill { transform: scaleX(1); }
  /* 자동 넘김이 켜져 있으면(data-auto) 흰 막대가 --dur 시간 동안 왼쪽에서 오른쪽으로 차오름 */
  .hero[data-auto] [aria-current='true'] .fill { animation: hero-fill var(--dur) linear forwards; }
  /* 잠깐 멈춤(data-hold) 중에는 차오르던 막대도 그 자리에서 멈춤 */
  /* (위 줄보다 선택자가 더 구체적이어야 위 줄의 animation 설정을 이길 수 있어서 길게 씁니다) */
  .hero[data-auto][data-hold] [aria-current='true'] .fill { animation-play-state: paused; }
  @keyframes hero-fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
</style>

<script>
  // 슬라이드 넘기기 + 자동 넘김.
  // 자동 넘김의 '타이머'는 따로 두지 않고, 점 안의 흰 막대가 다 차오르면(animationend) 다음 장으로 넘깁니다.
  // 그래서 막대를 멈추면 넘김도 같이 멈추고, 다시 풀면 남은 시간만큼 이어서 갑니다.
  const root = document.querySelector<HTMLElement>('section.hero');
  if (root) {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const bgs = [...root.querySelectorAll<HTMLElement>('[data-bg]')];
    const dots = [...root.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const counter = root.querySelector('[data-counter]');
    const area = root.querySelector<HTMLElement>('[data-slides]');
    const toggle = root.querySelector<HTMLButtonElement>('[data-toggle]');
    let cur = 0;   // 지금 보이는 슬라이드 번호(0부터 시작)

    // show(i): i번째 슬라이드만 보이게 하고, 점 표시와 '1 / 4' 숫자를 맞춥니다.
    // (i + 개수) % 개수 → 마지막에서 '다음'으로 가면 처음으로 돌아가게 하는 계산
    const show = (i: number) => {
      cur = (i + slides.length) % slides.length;
      slides.forEach((s, k) => s.toggleAttribute('data-active', k === cur));
      bgs.forEach((b) => (b.hidden = Number(b.dataset.bg) !== cur));   // 배경 이미지도 같이 바꿈
      dots.forEach((d, k) => {
        if (k === cur) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');
      });
      if (counter) counter.textContent = `${cur + 1} / ${slides.length}`;
    };
    root.querySelector('[data-prev]')?.addEventListener('click', () => show(cur - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(cur + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));

    // 흰 막대가 끝까지 차면 다음 슬라이드로
    root.querySelectorAll('.fill').forEach((f) => f.addEventListener('animationend', () => show(cur + 1)));

    // setAuto(true/false): 자동 넘김 켜기·끄기 (멈춤/재생 버튼)
    const setAuto = (on: boolean) => {
      root.toggleAttribute('data-auto', on);
      // 자동으로 넘어가는 동안에는 화면낭독기가 매번 읽지 않도록 aria-live를 끕니다.
      area?.setAttribute('aria-live', on ? 'off' : 'polite');
      if (toggle) {
        toggle.setAttribute('aria-label', on ? '자동 넘김 멈추기' : '자동 넘김 시작');
        toggle.querySelector('[data-icon-pause]')?.toggleAttribute('hidden', !on);
        toggle.querySelector('[data-icon-play]')?.toggleAttribute('hidden', on);
      }
    };

    // hold(이유, true/false): 잠깐 멈춤. 이유가 하나라도 남아 있으면 멈춘 상태를 유지합니다.
    const holds = new Set<string>();
    const hold = (why: string, on: boolean) => {
      if (on) holds.add(why); else holds.delete(why);
      root.toggleAttribute('data-hold', holds.size > 0);
    };
    // ① 마우스를 슬라이드 글자 위에 올려두면 멈춤 (읽는 중일 수 있으니까)
    //    pointerType이 'mouse'일 때만 → 휴대폰 터치로는 멈추지 않게
    area?.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hold('hover', true); });
    area?.addEventListener('pointerleave', (e) => { if (e.pointerType === 'mouse') hold('hover', false); });
    // ② 키보드(Tab)로 배너 안의 버튼·링크에 들어와 있으면 멈춤
    root.addEventListener('focusin', (e) => hold('focus', (e.target as HTMLElement).matches(':focus-visible')));
    root.addEventListener('focusout', (e) => { if (!root.contains(e.relatedTarget as Node)) hold('focus', false); });
    // ③ 다른 탭을 보고 있으면 멈춤
    document.addEventListener('visibilitychange', () => hold('tab', document.hidden));

    toggle?.addEventListener('click', () => setAuto(!root.hasAttribute('data-auto')));
    if (toggle) toggle.hidden = false;

    // 기기 설정에서 '동작 줄이기'를 켠 분께는 자동 넘김을 끈 상태로 시작합니다.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    setAuto(!reduce);
  }
</script>
