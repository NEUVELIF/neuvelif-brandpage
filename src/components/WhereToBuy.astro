---
// 공식 구매처 — 데이터는 src/data/stores.ts 한 곳에서 관리합니다.
import { STORES, PRODUCT_LABEL, type ProductKey } from '../data/stores';
interface Props { product?: ProductKey | 'all'; title?: string; compact?: boolean }
const { product = 'all', title = '공식 구매처', compact = false } = Astro.props;
const countries = [{ code: 'kr', label: '한국' }, { code: 'jp', label: '일본' }] as const;
const tile = 'display: flex; justify-content: space-between; align-items: center; gap: 12px; min-height: 64px; padding: 0 20px; border: 1px solid #D5E0E8; background: #FFFFFF; color: #12324F; text-decoration: none; font-weight: 700';
const arrow = '<svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex: none"><path d="M7 17L17 7"></path><path d="M8 7h9v9"></path></svg>';
function linksFor(s: (typeof STORES)[number]) {
  if (product !== 'all') {
    const url = s.products[product] ?? s.brandUrl;
    return url ? [{ url, label: '' }] : [];
  }
  if (s.brandUrl) return [{ url: s.brandUrl, label: '' }];
  return (Object.keys(s.products) as ProductKey[]).map((k) => ({ url: s.products[k]!, label: PRODUCT_LABEL[k] }));
}
---
<section id="buy" aria-labelledby="buy-title" style={`border-top: 1px solid #D5E0E8; padding: ${compact ? 'clamp(40px, 5vw, 64px)' : 'clamp(48px, 6vw, 88px)'} 0`}>
<div style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 12px">
{!compact && <p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">WHERE TO BUY</p>}
<h2 id="buy-title" style={`margin: 0; font-size: ${compact ? 'clamp(20px, 2vw, 24px)' : 'clamp(24px, 2.6vw, 34px)'}; line-height: 1.3; color: #12324F`}>{title}</h2>
<p style="margin: 0; color: #3C4752">전국 제휴 약국에서도 만나실 수 있습니다.</p>
</div>
{countries.map((c) => {
  const list = STORES.filter((s) => s.country === c.code).map((s) => ({ s, links: linksFor(s) })).filter((x) => x.links.length);
  return list.length > 0 && (
    <div style="display: flex; flex-direction: column; gap: 12px">
    <h3 style="margin: 0; font-size: 15px; color: #56626D">{c.label}</h3>
    <ul style="list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr)); gap: 12px">
    {list.map(({ s, links }) => links.length === 1 ? (
      <li><a href={links[0].url} rel="noopener" target="_blank" style={tile}><span>{s.name}<span class="sr-only"> (새 창)</span></span><Fragment set:html={arrow} /></a></li>
    ) : (
      <li style="border: 1px solid #D5E0E8; min-height: 64px; padding: 10px 20px; box-sizing: border-box; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 4px 12px">
        <span style="font-weight: 700; color: #12324F">{s.name}</span>
        <span style="display: flex; gap: 12px; font-size: 14px">{links.map((l) => <a href={l.url} rel="noopener" target="_blank" style="color: #1170AE; font-weight: 700; text-underline-offset: 3px">{l.label}<span class="sr-only"> (새 창)</span></a>)}</span>
      </li>
    ))}
    </ul>
    </div>
  );
})}
</div>
</section>
