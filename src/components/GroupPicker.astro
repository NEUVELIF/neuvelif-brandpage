---
// 홈의 '어떤 시술을 받으셨나요?' — 시술 그룹 7개 요약
import { GROUPS } from '../data/home';
// 칩 버튼의 기본 모양. 선택 여부에 따라 색은 src/scripts/picker.ts 가 바꿉니다.
const chip = 'min-height: 46px; padding: 10px 20px; border-radius: 999px; font-family: inherit; font-size: 15px; cursor: pointer';
---
<section id="guide" aria-labelledby="guide-title" style="background: #FFFFFF; padding: clamp(56px, 7vw, 104px) 0">
<div data-picker data-param="g" style="max-width: 1240px; margin: 0 auto; padding: 0 clamp(20px, 4vw, 48px); box-sizing: border-box; display: flex; flex-direction: column; gap: 32px">
<div style="display: flex; flex-direction: column; gap: 12px; max-width: 760px">
<p style="margin: 0; font-family: 'Barlow Condensed', 'Noto Sans KR', sans-serif; font-size: 16px; font-weight: 600; letter-spacing: 0.12em; color: #1170AE">PROCEDURE GUIDE</p>
<h2 id="guide-title" style="margin: 0; font-size: clamp(26px, 3vw, 38px); line-height: 1.3; letter-spacing: -0.01em; color: #12324F">어떤 시술을 받으셨나요?</h2>
<p style="margin: 0; color: #3C4752">시술 뒤 피부 상태에 따라 묶었습니다. 시술을 고르면 선크림과 클렌징 밀크를 언제부터 쓰면 되는지 보여 드립니다.</p>
</div>
<div role="group" aria-label="시술 종류" style="display: flex; flex-wrap: wrap; gap: 10px">
{GROUPS.map((g, i) => (
  <button type="button" data-pick={i} data-base={chip} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`group-${i}`}
    style={`${chip}; ${i === 0 ? 'border: 1px solid #12324F; background: #12324F; color: #FFFFFF; font-weight: 700' : 'border: 1px solid #B9C9D6; background: #FFFFFF; color: #12324F; font-weight: 500'}`}>{g.label}</button>
))}
</div>
{GROUPS.map((g, i) => (
<div id={`group-${i}`} data-panel={i} style="background: #FFFFFF; border: 1px solid #D5E0E8; padding: clamp(20px, 3vw, 40px); display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 6px">
<h3 style="margin: 0; font-size: clamp(20px, 2vw, 26px); line-height: 1.35; color: #12324F">{g.label}</h3>
<p style="margin: 0; color: #3C4752">{g.desc}</p>
<p style="margin: 0; font-size: 14px; color: #56626D">{g.examples}</p>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 16px">
<div style="flex: 1 1 260px; min-width: 0; border: 1px solid #D5E0E8; border-top: 3px solid #1170AE; background: #FFFFFF; padding: 22px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 14px; font-weight: 700; color: #12324F">백합 리커버리 선크림</p>
<p style="margin: 0; font-size: clamp(20px, 2vw, 24px); font-weight: 700; line-height: 1.35">{g.sun}</p>
<p style="margin: 0; color: #3C4752">{g.sunNote}</p>
</div>
<div style="flex: 1 1 260px; min-width: 0; border: 1px solid #D5E0E8; border-top: 3px solid #2F5233; background: #FFFFFF; padding: 22px; display: flex; flex-direction: column; gap: 6px">
<p style="margin: 0; font-size: 14px; font-weight: 700; color: #2F5233">말차 디퍼핑 클렌징 밀크</p>
<p style="margin: 0; font-size: clamp(20px, 2vw, 24px); font-weight: 700; line-height: 1.35">{g.clean}</p>
<p style="margin: 0; color: #3C4752">{g.cleanNote}</p>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px 24px; border-top: 1px solid #D5E0E8; padding-top: 20px">
<div style="display: flex; flex-direction: column; gap: 2px">
<p style="margin: 0"><strong>함께 지킬 것</strong> · {g.avoid}</p>
<p style="margin: 0; font-size: 14px; color: #56626D">시술한 병원의 안내가 다르면 병원 안내를 따르세요.</p>
</div>
{g.href
  ? <a href={g.href} style="display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: #12324F; color: #FFFFFF; text-decoration: none; font-weight: 700; letter-spacing: 0.04em">이 시술 가이드 자세히 보기</a>
  : <p style="margin: 0; font-size: 14px; color: #56626D">이 그룹의 자세한 가이드는 준비 중입니다.</p>}
</div>
</div>
))}
</div>
</section>

{/* 칩 동작은 공통 파일(src/scripts/picker.ts)을 불러와 씁니다 */}
<script>
  import { initPickers } from '../scripts/picker';
  initPickers();
</script>
